# v0.3 tour: the screens of cpa-fw 0.3.x, from boot to a meeting recording, plus the
# status bar states and the refusals. Run:
#   .pio/build/sim/program shots scripts/v03_tour.cpas --out out/v03
boot store=sd usb=on bat=4100
wait 1200
shot status-no-daemon  USB host, no daemon yet

include common/demo_state.cpas
shot board-needs-you  Board: a session waits (toast)
wait 2600
shot board-home  Board: two projects, online

# A project page: the sessions tab, then the queue tab.
press opt+1
shot project-sessions  acmeshop: sessions
press right
shot project-queue  acmeshop: queue
press left

# G0 tap: the capture overlay (a note for the project in front).
press g0
type call the vet on Friday re: Bingo's shots
shot capture-note  Capture: note -> acmeshop
press enter
shot status-syncing  Saved: syncing until the Mac acks
reply outbox.ack outbox.item {"status":"stored"}
wait 300

# Enter on a waiting session: a reply to it (the title names the session).
press enter
type yes, retry with exponential backoff
shot reply-compose  Reply to a waiting session
press `
shot reply-discard  Leaving with text asks first (` since docs/20 D5)
wait 400  # the prompt's 400 ms guard (docs/20 U18)
press enter

# Opt+S: a new Claude Code session, confirmed.
press opt+s
type add retry tests for the payment webhook
shot spawn-compose  New session: compose
press enter
wait 500
shot spawn-confirm  New session: confirm
press enter
reply agent.result agent.spawn {"ok":true,"name":"acmeshop/retry-tests","short":"e1f2a3"}
shot spawn-started  New session started
wait 2600

# Opt+I: what waits for you. Opt+M: the system page.
press opt+i
shot inbox  Inbox: one session needs you
press opt+m
shot settings  设置 (docs/21): WiFi, 语言 Language, link, sync
press /
shot system  设备: the diagnostics
press opt+h

# Voice memo: G0 held, tagged with 1 while talking, released to save.
down g0
wait 600
mic 3200 2500
press 1
shot memo-recording  Memo: recording, tagged acmeshop
up g0
wait 800
shot memo-saved  Memo saved: 1 recording to sync
wait 2600

# Opt+R: the meeting consent, the meeting page with a star, the end confirm.
press opt+r
shot meeting-confirm  Meeting: consent
wait 500
press enter
mic 65000 1200
press space
shot meeting-page  Meeting: recording, starred
wait 1000
press opt+r
shot meeting-end  Meeting: end?
wait 500
press enter
wait 1500
shot meeting-saved  Meeting saved

# Unplugged: offline, and a new session in a project can only be queued.
wait 2600
usb off
wait 700
shot status-offline  Offline (USB unplugged)
press opt+2
press opt+s
type try the new webhook signature check
press enter
wait 500
shot spawn-offline  New session while offline: queued instead
press `
press opt+h
usb on
wait 200
include common/hello.cpas
wait 2600

# Low battery: the bar turns red and recording is refused.
bat 3350
wait 1100
hold g0 600
shot refusal-battery  Low battery: recording refused

# No SD card: the internal store, recording is refused.
boot store=internal usb=on bat=4100
include common/demo_state.cpas
wait 2600
hold g0 600
shot refusal-nosd  No SD card: recording refused
