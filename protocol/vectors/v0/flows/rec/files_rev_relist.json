{
  "name": "files_rev_relist",
  "spec": "docs/11-m3-design.md §6.2.4",
  "description": "A memo is committed while the host is in the middle of a file. The host finishes that file from the same offset, deletes it, and only then lists again, because the observed rev differs from the expected rev (rev at listing time plus its own successful deletes). After that, its own delete alone needs no relist.",
  "initial": {"device.link": "Ready", "host.link": "ready"},
  "steps": [
    {"t": 0, "from": "host", "msg": {"v": 0, "t": "ping", "id": "h30"}},
    {
      "t": 10,
      "from": "device",
      "msg": {
        "v": 0,
        "t": "pong",
        "id": "d30",
        "re": "h30",
        "up_ms": 1000000,
        "pending": 0,
        "revs": {"projects": 42, "sessions": 17, "queue": 9},
        "files": {"n": 1, "rev": 5, "live": false}
      }
    },
    {
      "t": 20,
      "from": "host",
      "msg": {"v": 0, "t": "file.list", "id": "h31", "max": 4},
      "note": "expected rev = 5 (listed at rev 5, no own deletes yet)"
    },
    {
      "t": 30,
      "from": "device",
      "msg": {
        "v": 0,
        "t": "file.items",
        "id": "d31",
        "re": "h31",
        "items": [
          {
            "id": "3QZK1M7-00042-0A24",
            "kind": "rec",
            "size": 1424,
            "sha256": "ff9f1dda63b19a178b47714104c42f45cd0547b47c6fcd4c929cfb7ee87b99e8",
            "rec": "3QZK1M7-00042-0A1C",
            "seg": 3,
            "last": true,
            "mode": "meeting",
            "dur_ms": 43,
            "at": {"up_ms": 1600000, "wall_ms": null},
            "project": "cpa"
          }
        ],
        "more": false
      }
    },
    {
      "t": 40,
      "from": "host",
      "msg": {"v": 0, "t": "file.get", "id": "h32", "fid": "3QZK1M7-00042-0A24", "off": 0, "len": 1380}
    },
    {
      "t": 50,
      "from": "device",
      "msg": {
        "v": 0,
        "t": "file.data",
        "id": "d32",
        "re": "h32",
        "fid": "3QZK1M7-00042-0A24",
        "off": 0,
        "n": 1380,
        "size": 1424,
        "crc": 1323587514,
        "b64": ""
      }
    },
    {
      "t": 60,
      "from": "host",
      "msg": {"v": 0, "t": "file.get", "id": "h33", "fid": "3QZK1M7-00042-0A24", "off": 1380, "len": 1380}
    },
    {
      "t": 62,
      "from": "device",
      "msg": {"v": 0, "t": "error", "id": "d33", "re": "h33", "code": "E_BUSY", "msg": "live"},
      "note": "the user just pressed G0: a memo is recording"
    },
    {"t": 5000, "from": "host", "msg": {"v": 0, "t": "ping", "id": "h34"}},
    {
      "t": 5010,
      "from": "device",
      "msg": {
        "v": 0,
        "t": "pong",
        "id": "d34",
        "re": "h34",
        "up_ms": 1004990,
        "pending": 0,
        "revs": {"projects": 42, "sessions": 17, "queue": 9},
        "files": {"n": 1, "rev": 5, "live": true}
      }
    },
    {"t": 10000, "from": "host", "msg": {"v": 0, "t": "ping", "id": "h35"}},
    {
      "t": 10010,
      "from": "device",
      "msg": {
        "v": 0,
        "t": "pong",
        "id": "d35",
        "re": "h35",
        "up_ms": 1009990,
        "pending": 0,
        "revs": {"projects": 42, "sessions": 17, "queue": 9},
        "files": {"n": 2, "rev": 6, "live": false}
      },
      "note": "memo committed: rev 6 differs from the expected 5, but a file is in progress, so no relist yet"
    },
    {
      "t": 10020,
      "from": "host",
      "msg": {"v": 0, "t": "file.get", "id": "h36", "fid": "3QZK1M7-00042-0A24", "off": 1380, "len": 1380},
      "note": "finish the current file from the same offset; never restart it"
    },
    {
      "t": 10030,
      "from": "device",
      "msg": {
        "v": 0,
        "t": "file.data",
        "id": "d36",
        "re": "h36",
        "fid": "3QZK1M7-00042-0A24",
        "off": 1380,
        "n": 44,
        "size": 1424,
        "crc": 835397335,
        "b64": "c/9y/YT7ufkd+L72pfXb9Gb0SvSH9Bv1A/Y29634W/o1/Cv+LwAyAiQE9wU="
      }
    },
    {
      "t": 10040,
      "from": "host",
      "msg": {
        "v": 0,
        "t": "file.del",
        "id": "h37",
        "fid": "3QZK1M7-00042-0A24",
        "size": 1424,
        "sha256": "ff9f1dda63b19a178b47714104c42f45cd0547b47c6fcd4c929cfb7ee87b99e8"
      }
    },
    {
      "t": 10050,
      "from": "device",
      "msg": {"v": 0, "t": "ack", "id": "d37", "re": "h37"},
      "note": "own delete: device rev 6 -> 7"
    },
    {
      "t": 10060,
      "from": "host",
      "msg": {"v": 0, "t": "file.list", "id": "h38", "max": 4},
      "note": "between files and observed rev (6) != expected (5): relist"
    },
    {
      "t": 10070,
      "from": "device",
      "msg": {
        "v": 0,
        "t": "file.items",
        "id": "d38",
        "re": "h38",
        "items": [
          {
            "id": "3QZK1M7-00042-0A25",
            "kind": "rec",
            "size": 64044,
            "sha256": "f2bd5a6fdc3f8bf1abc678754a79752175699cc7308c9eb852f72553d910c776",
            "rec": "3QZK1M7-00042-0A25",
            "seg": 0,
            "last": true,
            "mode": "memo",
            "dur_ms": 2000,
            "at": {"up_ms": 1001200, "wall_ms": null},
            "lead_ms": 200
          }
        ],
        "more": false
      },
      "note": "expected rev is now 6 + 1 own delete = 7"
    },
    {"t": 15000, "from": "host", "msg": {"v": 0, "t": "ping", "id": "h39"}},
    {
      "t": 15010,
      "from": "device",
      "msg": {
        "v": 0,
        "t": "pong",
        "id": "d39",
        "re": "h39",
        "up_ms": 1014990,
        "pending": 0,
        "revs": {"projects": 42, "sessions": 17, "queue": 9},
        "files": {"n": 1, "rev": 7, "live": false}
      },
      "note": "rev 7 == expected 7: no relist"
    },
    {
      "t": 15020,
      "from": "host",
      "msg": {"v": 0, "t": "file.get", "id": "h40", "fid": "3QZK1M7-00042-0A25", "off": 0, "len": 1380}
    },
    {
      "t": 15030,
      "from": "device",
      "msg": {
        "v": 0,
        "t": "file.data",
        "id": "d40",
        "re": "h40",
        "fid": "3QZK1M7-00042-0A25",
        "off": 0,
        "n": 1380,
        "size": 64044,
        "crc": 1011080731,
        "b64": ""
      }
    },
    {"t": 15030, "expect": {"host.credit_used": 0}}
  ]
}
