# docs/20 U25 regression (from the review's s08): the cable comes out right after a spawn is
# sent, so the device saves the task as an uncertain queue item; the Mac did start it. Before
# the fix queue.snapshot dropped "uncertain" and Enter on the item offered to start it again
# with nothing to say it may already run.
boot store=sd usb=on bat=4100
include ../common/demo_state.cpas
press opt+1
press opt+s
type add retry tests for webhook
press enter
wait 500
press enter
shot 01-sent  Enter: agent.spawn sent
usb off
wait 5900
usb on
wait 200
include ../common/hello.cpas
reply outbox.ack outbox.item {"status":"stored"}
host sessions.snapshot {"rev":8,"total":4,"sessions":[{"sid":"8d3e7a19","slot":1,"name":"支付回调重试","kind":"tty","st":"waiting","need":true,"age_s":600},{"sid":"5c2e8a14","slot":2,"name":"host-sim","kind":"bg","st":"busy","need":false,"age_s":75,"short":"a1b2c3"},{"sid":"9f00aa11","slot":1,"name":"landing page copy","kind":"bg","st":"idle","need":false,"age_s":3600,"short":"d4e5f6"},{"sid":"c0ffee01","slot":1,"name":"add-retry-tests-for","kind":"bg","st":"busy","need":false,"age_s":20,"short":"77aa88"}]}
host queue.snapshot {"rev":3,"items":[{"qid":"q20","slot":1,"text":"add retry tests for webhook","intent":"spawn","uncertain":true},{"qid":"q18","slot":1,"text":"write e2e test for refunds","intent":"spawn"},{"qid":"q17","slot":1,"text":"给 webhook 加签名校验","intent":"todo"}]}
wait 2600
press opt+1
shot 02-sessions  the session already runs on the Mac
press /
shot 03-queue  the same task is in the queue (q20)
press enter
wait 500
shot 04-confirm  Enter on q20: the title "在 acmeshop 开 session" stays, "可能已开过，先看 Sessions" (yellow) on a row of its own
press `
press down
press enter
wait 500
shot 05-plain-item  Enter on q18 (not uncertain): the usual "在 acmeshop 开 session"
