    {
      "t": 40,
      "from": "host",
      "msg": {"v": 0, "t": "file.get", "id": "h22", "fid": "3QZK1M7-00042-0A22", "off": 0, "len": 1380}
    },
    {
      "t": 40,
      "from": "host",
