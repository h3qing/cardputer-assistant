      "code": "E_BAD_FIELD",
      "field": "keys[0]"
    },
    {
      "name": "key name in upper case",
      "dir": "h2d",
      "msg": {"v": 0, "t": "debug.key", "id": "h70", "keys": ["A"]},
      "code": "E_BAD_FIELD",
      "field": "keys[0]"
