{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardputer-assistant.invalid/protocol/v0/debug.key.schema.json",
  "title": "debug.key",
  "description": "TEST FIRMWARE ONLY (-DCPA_TEST_HOOKS=1). Press the listed keys together, hold hold_ms (default 50), release. Reply: ack.",
  "x-dir": ["h2d"],
  "type": "object",
  "allOf": [{"$ref": "common.schema.json#/$defs/request"}],
  "required": ["keys"],
  "properties": {
    "t": {"const": "debug.key"},
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/keyName"}
    },
    "hold_ms": {"type": ["integer", "null"], "minimum": 0, "maximum": 5000}
  }
}
