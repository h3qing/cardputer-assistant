# docs/28 §3.3, §5 (S1a): kept copies are plain on the card. Settings → Storage → Clear kept
# opens a box with the cursor on Cancel (Enter alone never clears); / then Enter clears. The lock
# card shows kept N while some are kept.
boot store=sd usb=on bat=4100 lang=zh
include home_mac.cpas
include memo.cpas
include memo.cpas
include memo.cpas
pull
press opt+l
wait 300
press enter
shot lock  the lock card: √ synced and kept 3 (kept copies are on the card)
press opt+l
press enter
wait 300
press opt+m
press ,
press .
press .
shot clear-row  the cursor on Clear kept 3 files
press enter
shot box  Enter: Clear 3 kept files? the cursor on Cancel
press /
shot box-yes  / : the cursor on Clear
press enter
wait 300
shot cleared  Enter: Kept copies cleared; Clear kept none
