# v0.4.0 tour: whole-device navigation (docs/13 §4-§7, docs/releases/v0.4.0.md). The home
# launcher and its letters, the Tab menu (Here / Go / Control) on pages and over overlays,
# Opt+L lock on a lit and on a dark screen, a memo and a meeting while locked (● always
# visible), and back navigation. Captions are short: the contact sheet cuts them at 240 px.
# Run:
#   .pio/build/sim/cpa-sim shots scripts/v04_tour.cpas --out out/v04_tour
boot store=sd usb=on bat=4100 lang=zh
wait 1200
shot home-empty  Home: booted, no Mac yet

# The demo board: two projects, one session waiting (acmeshop/支付回调重试, 9 min).
include common/demo_state.cpas
wait 2600
shot home  Home: 2 running, !1 and the most urgent session

# On home a letter is Opt+that letter; 1-9 opens a project page.
press p
shot home-p  Home, P: Project board
press opt+h
press i
shot home-i  Home, I: Inbox
press opt+h
press m
shot home-m  Home, M: System
press opt+h
press 1
shot home-1  Home, 1: Project 1
press opt+h
# ; . , / move the selection; Enter presses the selected tile's key.
press right
press down
shot home-move  Home, / .: onto Q, AI queue
press opt+h

# Tab on home: Here (the tiles), Go, Control.
press tab
shot menu-here  Tab menu · Here (Home)
press down ms=60
press down ms=60
press down ms=60
press down ms=60
press down ms=60
press down ms=60
press down ms=60
press down ms=60
shot menu-here-scroll  Here, scrolled down: L and 1-9
press /
shot menu-goto  , / change page: Go
press down ms=60
press down ms=60
press down ms=60
press down ms=60
press down ms=60
press down ms=60
press down ms=60
shot menu-goto-scroll  Go, scrolled down
press down ms=60
press down ms=60
press down ms=60
press down ms=60
press down ms=60
shot menu-goto-end  Go: the last rows
press /
shot menu-control  Control: Lock and read-only status
press tab
shot menu-closed  Tab closes the menu

# Enter on a row: the menu closes and presses that row's key.
press tab
press /
press down
shot menu-goto-sel  Go: Opt+P Projects selected
press enter
shot menu-enter  Enter: pressed Opt+P for you
press opt+h

# Tab, then a letter: Opt+that letter.
press tab
press i
shot menu-letter  Tab, then I: Inbox
press opt+h

# The menu over a project page: the page's own keys on Here.
press opt+1
press tab
shot menu-project  Tab on a project page: Here
press /
shot menu-project-goto  Tab on a project page: Go
press tab

# The menu over the capture page: only Here and Control; the draft stays.
press g0
shot capture-empty  Empty capture page: hint bar has [Tab]menu
type call the vet on Friday
shot capture  Capture page: hint bar ends in [Tab]menu
press tab
shot menu-capture  Tab on capture: only Here and Control
press p
shot menu-capture-letter  P on Here: the menu eats it
press down ms=60
press down ms=60
press down ms=60
press down ms=60
press down ms=60
press down ms=60
press down ms=60
press down ms=60
shot menu-capture-scroll  Capture, Here scrolled down
press /
shot menu-capture-control  Tab on capture: Control
press tab
shot capture-kept  Menu closed: the draft stays
# Opt+L on the capture page: the draft stays under the lock.
press opt+l
shot lock-capture  Opt+L on capture: locked
press opt+l
press enter
shot unlock-capture  Unlocked: the draft stays
press `
press tab
shot menu-discard  Tab on Discard draft?
press tab
wait 400  # the prompt's 400 ms guard (docs/20 U18)
press enter
press opt+h
wait 2600

# G0 held with the menu open: the menu closes and the memo starts as usual.
press tab
down g0
wait 600
mic 1500 2500
shot menu-memo  G0 held, menu open: memo, ● shows
up g0
wait 300
wait 2600

# Opt+L on a lit screen (USB in): the keyboard locked; the card says so for 2 s, then dark
# (docs/20 D7).
press opt+l
shot lock-lit  Opt+L: locked, the card says Locked for 2 s
wait 2200
press p
press enter
press tab
shot lock-keys  Locked: other keys do nothing
press g0
shot lock-card  Tap G0: the lock card lights
# The card is lit: holding G0 now records a memo, still locked.
down g0
wait 600
mic 2400 2500
shot lock-memo  Card lit, G0 held: recording
up g0
wait 900
shot lock-memo-done  Done: the card shows the result 2 s, then dark, locked
press opt+l
shot unlock-1  Opt+L: card lit, a 3 s window
wait 3200
press enter
shot unlock-late  Enter after 3 s does nothing
press opt+l
press enter
shot unlock  Opt+L, then Enter: back to Home
wait 2600

# A dark screen: on battery (USB out), 60 s without a key turn the screen off and lock it
# (docs/20 D2); Opt+L there is the lock's own key.
usb off
wait 61000
shot dark  60 s without a key: screen off and locked
press opt+l
shot lock-dark  Opt+L when dark: card lit, a 3 s window
hold g0 600
shot lock-dark-hold  G0 held: card lit, no rec (tap G0 first)
wait 3200
press opt+l
press enter
shot unlock-dark  Unlocked: Home, offline
usb on
wait 200
include common/hello.cpas
wait 2600

# A meeting: consent, the page, the Tab menu over it (● stays in the status bar).
press opt+r
shot meeting-confirm  Opt+R: the Start meeting? box
press tab
shot menu-meeting-confirm  Tab on the Start meeting? box
press tab
wait 500
press enter
# A block every 128 ms, as on the device: speech, so the timeline grows and the ★ lands on it.
mic 5000 speech
press space
mic 1500 speech
shot meeting  Meeting page: recording, ★1
press tab
shot menu-meeting  Tab on the meeting: ● still shows
press down ms=60
press down ms=60
press down ms=60
press down ms=60
press down ms=60
press down ms=60
shot menu-meeting-scroll  Meeting, Here scrolled down
press /
shot menu-meeting-control  Tab on the meeting: Control
press g0
mic 600 speech
shot menu-meeting-g0  G0 in the menu: closes it, adds ★
mic 2000 speech
host sessions.snapshot {"rev":6,"total":3,"sessions":[{"sid":"5a1e0c7d","slot":1,"name":"支付回调重试","kind":"tty","st":"waiting","need":true,"age_s":600},{"sid":"5c2e8a14","slot":2,"name":"cpa/host-sim","kind":"bg","st":"waiting","need":true,"age_s":5,"short":"a1b2c3"},{"sid":"9f00aa11","slot":1,"name":"landing page copy","kind":"bg","st":"idle","need":false,"age_s":3600,"short":"d4e5f6"}]}
host projects.snapshot {"rev":4,"projects":[{"slot":1,"key":"acmeshop","name":"Acmeshop 宠物","run":1,"need":1,"queued":2,"ok":true},{"slot":2,"key":"cardputer","name":"Cardputer 助手","run":1,"need":1,"queued":1,"ok":true}],"other":{"run":0,"n":2}}
shot meeting-toast  A toast in a meeting: ● still shows
press tab
shot menu-meeting-toast  Menu + toast: ● still shows
press tab
# Locked in a meeting: dimmed, only the ● line; G0 still stars.
press opt+l
mic 2000 speech
shot lock-meeting  Locked in a meeting: only the ● line
press g0
mic 700 speech
shot lock-meeting-star  G0 while locked: adds ★
press opt+l
mic 600 speech
shot lock-meeting-card  The lock card in a meeting
press enter
mic 1500 speech
shot meeting-unlocked  Unlocked: back to the meeting
press opt+r
shot meeting-end  Opt+R: End meeting?
press tab
shot menu-meeting-end  Tab on End meeting?
press tab
wait 500
press enter
wait 1500
shot meeting-saved  Meeting saved
wait 2600

# Back: a project page opened from the board is a second layer.
press opt+p
shot back-board  Opt+P: Project board
press enter
shot back-project  Enter: project page (second layer)
press `
shot back-to-board  Back: to the board
press `
shot back-home  Back again: Home
