# docs/21 §4 (ST-3): 设置 in Chinese. Opt+M opens the settings tab on the WiFi row: WiFi
# "无 · 只用 USB 线", "语言 Language 中文", a divider, the link (USB 线 · the Mac's name from
# hello's host_label, 在线 on the right) and the last sync. Enter on WiFi only shows words;
# ` goes back to the settings tab. `/` is the device tab: 8 rows, the warning row last.
# Pulled, the link row keeps the Mac's name and says 离线.
boot store=sd usb=on bat=4100
host hello {"role":"host","app":"cpad/0.4.1","agent":"ok","caps":{"spawn":true,"reply":true},"host_label":"工作 MBP"}
host time.set {"epoch_ms":1792546860000,"tz_min":480}
wait 1500
press opt+m
shot settings  设置: cursor on WiFi, 语言 Language 中文, 连接 工作 MBP 在线, 同步
press .
shot lang-row  . : the cursor on 语言 Language (the facts are never selected)
press ;
press enter
shot wifi  Enter on WiFi: only words, no switch; the Launcher line
press tab
shot wifi-menu  Tab on the WiFi page: 回到设置 / 主页
press tab
press `
shot back  ` : back on the settings tab, the cursor on WiFi
press /
shot device  / : the device tab, 8 rows, the divider after 启动
usb off
wait 1500
press ,
shot offline  pulled: 工作 MBP kept, 离线
