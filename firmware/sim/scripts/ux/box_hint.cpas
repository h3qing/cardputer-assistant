# Review regression (D3, D4). Before: G0 held on the meeting start box said "先处理确认框", and
# the hint stayed about 2 s on home after the box was gone (` or Opt+R closed it), telling
# the user to deal with a box that was no longer there.
# Now: the box's hints go with the box, however it goes (`, Opt+R, Enter, Opt+L, 15 s).
boot store=sd usb=on bat=4100
include ../common/demo_state.cpas
wait 1500
press opt+r
wait 600
down g0
wait 2000
shot held  G0 held on the start box: 先处理确认框
up g0
wait 100
press `
wait 300
shot cancelled  ` closed the box: home, no 先处理确认框
press opt+r
wait 600
down g0
wait 1200
up g0
wait 100
press opt+r
wait 300
shot opt-r  Opt+R closed the box: no 先处理确认框 either
