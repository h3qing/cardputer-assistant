{
  "name": "file_pull_resume",
  "spec": "docs/11-m3-design.md §5.3, §6.2.7",
  "description": "The daemon restarts while pulling a memo segment. After the new handshake it lists again and resumes from the .part size minus 64 KB, keeping at most four 1380 B file.get in flight; the pull then continues the same way until off reaches size.",
  "initial": {"device.link": "Ready", "host.link": "offline"},
  "steps": [
    {
      "t": 0,
      "event": "daemon_restart",
      "note": "cpad restarts mid-pull; rec-staging/<dev>/3QZK1M7-00042-0A20.part already holds 70380 B (51 chunks) from the previous run"
    },
    {
      "t": 100,
      "from": "host",
      "msg": {
        "v": 0,
        "t": "hello",
        "id": "h1",
        "role": "host",
        "app": "cpad/0.3.0",
        "agent": "ok",
        "caps": {"spawn": true, "reply": false}
      }
    },
    {
      "t": 115,
      "from": "device",
      "msg": {
        "v": 0,
        "t": "hello",
        "id": "d1",
        "re": "h1",
        "role": "device",
        "fw": "cpa-fw/0.3.0",
        "dev": "020000000001",
        "boot": "3QZK1M7-0000C",
        "up_ms": 53211,
        "rst": "poweron",
        "time": false,
        "pending": 0,
        "bat_mv": 4120,
        "revs": {"projects": 0, "sessions": 0, "queue": 0},
        "store": "sd",
        "launcher": true,
        "files": {"n": 1, "rev": 4, "live": false}
      }
    },
    {"t": 115, "expect": {"device.link": "Ready", "host.link": "ready", "host.credit_used": 0}},
    {
      "t": 120,
      "from": "host",
      "msg": {"v": 0, "t": "file.list", "id": "h2", "max": 4},
      "note": "new connection: list again before pulling"
    },
    {
      "t": 135,
      "from": "device",
      "msg": {
        "v": 0,
        "t": "file.items",
        "id": "d2",
        "re": "h2",
        "items": [
          {
            "id": "3QZK1M7-00042-0A20",
            "kind": "rec",
            "size": 200044,
            "sha256": "7ab3e80adad48c455ce68545f3d85b70ca4d4cb087df14125a15d7b01bf83029",
            "rec": "3QZK1M7-00042-0A20",
            "seg": 0,
            "last": true,
            "mode": "memo",
            "dur_ms": 6250,
            "at": {"up_ms": 412000, "wall_ms": null},
            "project": "cpa",
            "lead_ms": 200
          }
        ],
        "more": false
      }
    },
    {
      "t": 140,
      "from": "host",
      "msg": {"v": 0, "t": "file.get", "id": "h3", "fid": "3QZK1M7-00042-0A20", "off": 4844, "len": 1380},
      "note": "resume at the .part size minus 64 KB: 70380 - 65536 = 4844; up to 4 in flight"
    },
    {
      "t": 140,
      "from": "host",
      "msg": {"v": 0, "t": "file.get", "id": "h4", "fid": "3QZK1M7-00042-0A20", "off": 6224, "len": 1380}
    },
    {
      "t": 140,
      "from": "host",
      "msg": {"v": 0, "t": "file.get", "id": "h5", "fid": "3QZK1M7-00042-0A20", "off": 7604, "len": 1380}
    },
    {
      "t": 140,
      "from": "host",
      "msg": {"v": 0, "t": "file.get", "id": "h6", "fid": "3QZK1M7-00042-0A20", "off": 8984, "len": 1380}
    },
    {"t": 140, "expect": {"host.credit_used": 328}},
    {
      "t": 152,
      "from": "device",
      "msg": {
        "v": 0,
        "t": "file.data",
        "id": "d3",
        "re": "h3",
        "fid": "3QZK1M7-00042-0A20",
        "off": 4844,
        "n": 1380,
        "size": 200044,
        "crc": 2566119423,
        "b64": ""
      },
      "note": "host checks off and crc, appends to the .part"
    },
    {
      "t": 153,
      "from": "device",
      "msg": {
        "v": 0,
        "t": "file.data",
        "id": "d4",
        "re": "h4",
        "fid": "3QZK1M7-00042-0A20",
        "off": 6224,
        "n": 1380,
        "size": 200044,
        "crc": 4077801799,
        "b64": ""
      }
    },
    {
      "t": 153,
      "from": "host",
      "msg": {"v": 0, "t": "file.get", "id": "h7", "fid": "3QZK1M7-00042-0A20", "off": 10364, "len": 1380},
      "note": "one answered, one more sent: never more than file_inflight_max"
    },
    {
      "t": 154,
      "from": "device",
      "msg": {
        "v": 0,
        "t": "file.data",
        "id": "d5",
        "re": "h5",
        "fid": "3QZK1M7-00042-0A20",
        "off": 7604,
        "n": 1380,
        "size": 200044,
        "crc": 1612491985,
        "b64": ""
      }
    },
    {
      "t": 154,
      "from": "host",
      "msg": {"v": 0, "t": "file.get", "id": "h8", "fid": "3QZK1M7-00042-0A20", "off": 11744, "len": 1380}
    },
    {
      "t": 155,
      "from": "device",
      "msg": {
        "v": 0,
        "t": "file.data",
        "id": "d6",
        "re": "h6",
        "fid": "3QZK1M7-00042-0A20",
        "off": 8984,
        "n": 1380,
        "size": 200044,
        "crc": 3309322616,
        "b64": ""
      }
    },
    {
      "t": 166,
      "from": "device",
      "msg": {
        "v": 0,
        "t": "file.data",
        "id": "d7",
        "re": "h7",
        "fid": "3QZK1M7-00042-0A20",
        "off": 10364,
        "n": 1380,
        "size": 200044,
        "crc": 2377162383,
        "b64": ""
      }
    },
    {
      "t": 167,
      "from": "device",
      "msg": {
        "v": 0,
        "t": "file.data",
        "id": "d8",
        "re": "h8",
        "fid": "3QZK1M7-00042-0A20",
        "off": 11744,
        "n": 1380,
        "size": 200044,
        "crc": 1942285224,
        "b64": ""
      }
    },
    {"t": 167, "expect": {"host.credit_used": 0}}
  ]
}
