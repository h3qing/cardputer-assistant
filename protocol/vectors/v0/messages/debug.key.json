    {
      "name": "hold G0 600 ms (G0Long)",
      "dir": "h2d",
      "msg": {"v": 0, "t": "debug.key", "id": "h70", "keys": ["g0"], "hold_ms": 600}
    },
    {
      "name": "Fn+` (Esc)",
      "dir": "h2d",
      "msg": {"v": 0, "t": "debug.key", "id": "h70", "keys": ["fn", "`"]}
    },
    {
      "name": "Enter",
      "dir": "h2d",
      "msg": {"v": 0, "t": "debug.key", "id": "h70", "keys": ["enter"]}
    }
  ],
