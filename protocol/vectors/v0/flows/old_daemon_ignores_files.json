{
  "name": "old_daemon_ignores_files",
  "spec": "docs/11-m3-design.md §5.7",
  "description": "A v0.3 device with recordings on the card talks to a v0.2 daemon. hello and pong carry files; the daemon ignores them and never sends file.*. The recordings stay on the card and the device keeps showing the count.",
  "initial": {"device.link": "Attached", "host.link": "handshaking"},
  "steps": [
    {
      "t": 100,
      "from": "host",
      "msg": {
        "v": 0,
        "t": "hello",
        "id": "h1",
        "role": "host",
        "app": "cpad/0.2.0",
        "agent": "ok",
        "caps": {"spawn": true, "reply": false}
      },
      "note": "a v0.2 daemon"
    },
    {
      "t": 115,
      "from": "device",
      "msg": {
        "v": 0,
        "t": "hello",
        "id": "d1",
        "re": "h1",
        "role": "device",
        "fw": "cpa-fw/0.3.0",
        "dev": "020000000001",
        "boot": "3QZK1M7-0000C",
        "up_ms": 53211,
        "rst": "poweron",
        "time": false,
        "pending": 0,
        "bat_mv": 4120,
        "revs": {"projects": 0, "sessions": 0, "queue": 0},
        "store": "sd",
        "launcher": true,
        "files": {"n": 3, "rev": 9, "live": false}
      }
    },
    {"t": 115, "expect": {"device.link": "Ready", "host.link": "ready"}},
    {
      "t": 120,
      "from": "host",
      "msg": {"v": 0, "t": "time.set", "id": "h2", "epoch_ms": 1792440000000, "tz_min": -420}
    },
    {"t": 135, "from": "device", "msg": {"v": 0, "t": "ack", "id": "d2", "re": "h2"}},
    {"t": 5100, "from": "host", "msg": {"v": 0, "t": "ping", "id": "h3"}},
    {
      "t": 5115,
      "from": "device",
      "msg": {
        "v": 0,
        "t": "pong",
        "id": "d3",
        "re": "h3",
        "up_ms": 58226,
        "pending": 0,
        "revs": {"projects": 0, "sessions": 0, "queue": 0},
        "files": {"n": 3, "rev": 9, "live": false}
      },
      "note": "the v0.2 daemon ignores the unknown files field (no additionalProperties:false anywhere)"
    },
    {"t": 5115, "expect": {"host.credit_used": 0, "host.reboot_detected": false}}
  ]
}
