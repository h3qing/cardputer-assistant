# docs/20 D1 regression (U5; from the review's fm02_type_on_home and v_s10/b_overshoot). Before
# the fix home took every tile letter alone: "remind me…" opened the meeting box and a late
# Enter started a meeting, "lunch" locked the device. Now R and L need Opt, and the first
# letter that is no tile says once how to write a note. The other tiles stay single keys (D1),
# so a letter of theirs still opens its page ("m" 系统, "n" 记一条).
boot store=sd usb=on bat=4100
include ../common/demo_state.cpas
wait 2600
type remind me
shot typed  "remind me" on home: r only hints, no meeting box (m opened 系统)
press enter
wait 400
mic 3000 1500
shot after-enter  Enter: no recording
press opt+h
type lunch
shot lunch  "lunch": not locked; the hint, and n opened a note
press g0
wait 300
type rent
press bksp ms=60
press bksp ms=60
press bksp ms=60
press bksp ms=60
press bksp ms=60
type rent due friday
shot overshoot  a Backspace too many, then typing on home: no meeting box
press enter
mic 3000 1500
shot overshoot-enter  Enter: no meeting
press opt+h
press /
press /
press enter
shot r-tile  Enter on the R tile: the meeting box (as Opt+R)
press `
