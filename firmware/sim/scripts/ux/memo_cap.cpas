# docs/20 U15 regression (from the review's s12_memo_cap): a memo held past the 5 minute
# cap. Before the fix the screen jumped back to the page at 5:00 with a flash of
# "Recording saved" while G0 was still held, and the rest of the talk was lost unseen.
boot store=sd usb=on bat=4100 lang=zh
include ../common/demo_state.cpas
wait 1000
down g0
wait 600
mic 240000 2500
shot memo-4m  Memo, 4 min
mic 61000 2500
shot memo-5m01  5:01, G0 still held: "5 min reached: saved" / Let go of [G0]
mic 10000 2500
shot memo-5m11  5:11, still held: the same screen, not the page
up g0
wait 500
shot released  released: back to the page
