# docs/20 U13 regression (from the review's st01): a queue item aimed at a slot with no
# project. The Mac has two projects (the demo board). Before the fix Enter showed a red
# "保存失败（E_STORAGE）" and every later G0 note was sucked into the draft; a digit for
# slot 5 opened an empty "5 ? ·" page.
boot store=sd usb=on bat=4100
include ../common/demo_state.cpas
wait 2600
press opt+q
press opt+5
type buy dog food
press enter
wait 100
shot q-enter  Enter: "Opt+数字：1 acmeshop · 2 cardputer", the draft stays, no E_STORAGE
press opt+1
wait 100
shot q-retarget  Opt+1: the hint is gone (stale), title 排队给 AI → acmeshop
press enter
wait 100
shot q-saved  Enter: 已保存 · 待传 ↑N
wait 2600
press opt+5
wait 100
shot slot5  Opt+5: "没有第 5 个项目（共 2 个）", no empty page
press opt+p
press down
press down
press enter
wait 100
shot other-row  看板「其他」+ Enter: "其他项目只在 Mac 上看"
